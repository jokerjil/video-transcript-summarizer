# Every setting is optional. Copy to .env only if you want to change a default.
# This app makes NO network calls and needs NO API key.

# ---- Transcription (local) ----
# tiny | base | small | medium | large-v3   (bigger = more accurate, slower, more RAM/VRAM)
WHISPER_MODEL=base
# auto | cpu | cuda
WHISPER_DEVICE=auto
# auto | int8 | int8_float16 | float16 | float32
WHISPER_COMPUTE_TYPE=auto
# Force a language (e.g. en, de, fr). Leave unset to auto-detect.
# WHISPER_LANGUAGE=en
WHISPER_BEAM_SIZE=1
# beam_size=1 is ~1.7x faster than 5 in local testing, no measurable accuracy
# loss. Raise it only if you see transcription errors on hard/noisy audio.

# Extra speed on top of beam_size=1 (~25-30% more), at the cost of coarser
# timestamps (~30s blocks instead of per-sentence) in the transcript,
# chapters, and snapshot sync. Off by default - turn on for max speed.
WHISPER_BATCHED=false
WHISPER_BATCH_SIZE=8

# ---- Summary (local, extractive) ----
SUMMARY_SENTENCES=7
SUMMARY_KEY_POINTS=12
SUMMARY_CHAPTERS=8

# ---- Snapshots (video frames) ----
SNAPSHOT_COUNT=12
SNAPSHOT_WIDTH=640

# ---- Content moderation (offline - see README "Content moderation") ----
# Blocks explicit/18-plus video before transcription. Video only.
MODERATION_ENABLED=true
MODERATION_THRESHOLD=0.5
MODERATION_SAMPLE_COUNT=10

# ---- Web UI ----
# 8 GiB default upload cap.
MAX_UPLOAD_BYTES=8589934592
# OUTPUT_DIR=outputs
# UPLOAD_DIR=uploads
